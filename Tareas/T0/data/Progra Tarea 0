from copy import deepcopy

import os
from tablero import Tablero

class DCColores:
    def __init__(self) -> None:
        self.tableros = []
        self.tablero_actual = -1
        self.cambios_actuales = []
        if os.path.exists("data"):
            for archivo in os.listdir("data"):
                if archivo.endswith(".brd"):
                    self.cargar_tablero(archivo)

    def cargar_tablero(self, archivo_tablero: str) -> None:
        ruta = os.path.join("data", archivo_tablero)

        with open(ruta, "r", encoding="utf-8") as f:
            linea = f.readline().strip().split()
            n = int(linea[0])
            m = int(linea[1])

            inicio = []
            meta = []

            for _ in range(n):
                fila = f.readline().strip()
                nueva = []

                for c in fila:
                    if c == "_":
                        nueva.append(0)
                    elif c == "#":
                        nueva.append(1)
                    elif c == "O":
                        nueva.append(-1)

                inicio.append(nueva)

            for _ in range(n):
                fila = f.readline().strip()
                nueva = []

                for c in fila:
                    if c == "_":
                        nueva.append(0)
                    elif c == "#":
                        nueva.append(1)
                    elif c == "O":
                        nueva.append(-1)

                meta.append(nueva)

        tablero = Tablero(inicio, meta)
        self.tableros.append(tablero)

    def guardar_cambios(self, nombre_archivo: str) -> None:
        if self.tablero_actual == -1:
            return

        tablero = self.tableros[self.tablero_actual]

        ruta = os.path.join("data", nombre_archivo + ".chg")

        with open(ruta, "w", encoding="utf-8") as f:
            n = tablero.n
            m = tablero.m
            c = len(self.cambios_actuales)

            f.write(f"{n} {m} {c}\n")

            actual = tablero.inicio
            for fila in actual:
                texto = ""
                for valor in fila:
                    if valor == 0:
                        texto += "_"
                    elif valor == 1:
                        texto += "#"
                    else:
                        texto += "O"
                f.write(texto + "\n")

            for x, y in self.cambios_actuales:
                actual = tablero.cambiar_color(actual, x, y)

                f.write(f"{x} {y}\n")

                for fila in actual:
                    texto = ""
                    for valor in fila:
                        if valor == 0:
                            texto += "_"
                        elif valor == 1:
                            texto += "#"
                        else:
                            texto += "O"
                    f.write(texto + "\n")

            f.write("\n")

