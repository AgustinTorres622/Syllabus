class Tablero:
    def __init__(self, inicio: list[list[int]], meta: list[list[int]]) -> None:
        self.inicio = inicio
        self.meta = meta
        self.n = len(inicio)
        self.m = len(inicio[0])

#Aca le pedi ayuda a la ia no sabia que el self era la forma correcta de llamar a la funcion, segun lo que me dijo la Ia self es para crear una variable para toda la class, al principio lo hice estilo "N=len(inicio)"

    def cambiar_color(self, tablero_actual: list[list[int]],
                      x: int, y: int) -> list[list[int]]:
        nuevo = deepcopy(tablero_actual)

        for i in range(x-1, x+2):
            for j in range(y-1, y+2):
                if 0 <= i < self.n and 0 <= j < self.m:
                    if nuevo[i][j] != 0:
                        nuevo[i][j] *= -1

        return nuevo

    def aplicar_cambios(self, cambios: list[tuple[int]]) -> list[list[int]]:
        tablero = deepcopy(self.inicio)

        for x, y in cambios:
            tablero = self.cambiar_color(tablero, x, y)

        return tablero

    def validar_solucion(self, cambios: list[tuple[int]]) -> bool:
        final = self.aplicar_cambios(cambios)

        if final == self.meta:
            return True
        return False

    def encontrar_solucion(self, cambios: list[tuple[int]],
                           cambios_adicionales: int) -> list[tuple[int]]:

        tablero_actual = self.aplicar_cambios(cambios)

        def backtracking(tablero, restantes, lista_cambios):
            if tablero == self.meta:
                return lista_cambios

            if restantes == 0:
                return []

            for i in range(self.n):
                for j in range(self.m):
                    if tablero[i][j] != 0:
                        nuevo = self.cambiar_color(tablero, i, j)

                        resultado = backtracking(
                            nuevo,
                            restantes - 1,
                            lista_cambios + [(i, j)]
                        )

                        if resultado != []:
                            return resultado

            return []

        return backtracking(tablero_actual, cambios_adicionales, cambios)

    def optimizar_solucion(self, cambios: list[tuple[int]]) -> list[tuple[int]]:
        optimizada = []

        for cambio in cambios:
            if cambio in optimizada:
                optimizada.remove(cambio)
            else:
                optimizada.append(cambio)

        return optimizada
